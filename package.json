    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource-variable/red-hat-display": "^5.3.0",
    "@fontsource-variable/red-hat-mono": "^5.3.0",
    "@fontsource-variable/red-hat-text": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@fontsource-variable/roboto-slab": "^5.3.0",
