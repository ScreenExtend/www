    "@fontsource/fira-mono": "^5.3.0",
    "@fontsource/fira-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@fontsource/monaspace-neon": "^5.3.0",
    "@fontsource/monaspace-xenon": "^5.3.0",
    "@fontsource/zilla-slab": "^5.3.0",
    "daisyui": "^4.7.2",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-daisyui": "^5.0.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.17.0",
